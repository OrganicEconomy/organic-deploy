# Postgres (docker deployment)
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=organic_db

# host port : container port
NODE_LOCAL_PORT=8080
NODE_DOCKER_PORT=8080

# The server's SECP256K1 secret key (64 hex chars) — used to sign accounts and bills.
ORGANIC_SECRET_KEY=
# Human-readable name shown on the app's server-selection screen.
ORGANIC_SERVER_NAME=My organic server
