# Postgres (docker deployment)
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=organic_db

# host port : container port
NODE_LOCAL_PORT=8080
NODE_DOCKER_PORT=8080

# The server's SECP256K1 secret key (64 hex chars) — used to sign accounts and bills.
ORGANIC_SECRET_KEY=
# Passphrase used to encrypt every ecosystem's private key at rest in the
# database (the server needs to decrypt these to act as an ecosystem's
# custodian — signing order execution, salary distribution, paper
# counter-signing). Not a blockchain key itself, just a password — any long
# random string works. Must stay stable: changing it makes every already-
# encrypted ecosystem key unreadable.
ORGANIC_MASTER_KEY=
# Human-readable name shown on the app's server-selection screen.
ORGANIC_SERVER_NAME=My organic server
